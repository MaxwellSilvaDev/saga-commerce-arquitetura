@startuml
title Saga de compra — falha e compensação
autonumber
actor Cliente
participant "Order Service" as Order
participant "Saga Orchestrator" as Saga
queue "Message Broker" as Broker
participant "Inventory Service" as Inventory
participant "Payment Service" as Payment

Cliente -> Order: Solicitar compra
Order -> Order: Criar pedido (PENDING)
Order -> Saga: Iniciar Saga(orderId)
Saga -> Broker: ReserveStock(orderId)
Broker -> Inventory: ReserveStock
Inventory --> Broker: StockReserved
Broker --> Saga: StockReserved
Saga -> Broker: AuthorizePayment(orderId)
Broker -> Payment: AuthorizePayment
Payment --> Broker: PaymentDeclined
Broker --> Saga: PaymentDeclined
Saga -> Broker: CancelOrder(orderId)
Broker -> Order: CancelOrder
Order --> Broker: OrderCancelled
Broker --> Saga: OrderCancelled
Saga -> Broker: ReleaseStock(orderId)
Broker -> Inventory: ReleaseStock
Inventory --> Broker: StockReleased
Broker --> Saga: StockReleased
Saga -> Saga: Marcar Saga como COMPENSATED
Saga --> Cliente: Compra não concluída
@enduml
